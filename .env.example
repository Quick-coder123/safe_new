# Скопіюйте у .env.local (локально) та додайте ці ж змінні у Vercel:
# Project Settings → Environment Variables

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Секретний ключ service_role — ТІЛЬКИ на сервері, ніколи не додавайте префікс NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Секрет для підпису сесій адміністраторів (мінімум 32 символи).
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
